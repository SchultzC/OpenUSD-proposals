#usda 1.0
(
    doc = """Example: USD composition assembling simulation, CAD, and AI data.

    Demonstrates nondestructive composition of heterogeneous data
    sources in a single stage. Each source retains its own provenance
    and source of truth. An algorithm operating on the composed stage
    can access solver results and surrogate predictions through the
    same CaeDataSet interface."""
    defaultPrim = "DigitalTwin"
    subLayers = [
        @./cad_geometry.usd@,
        @./simulation_results.usd@,
        @./ai_surrogate_fields.usd@
    ]
)

def Xform "DigitalTwin"
{
    # CAD geometry from engineering (UsdGeom in the cad layer)
    def "Geometry" (
        references = </CADModel/Body>
    )
    {
    }

    # Solver results (CaeDataSet from the simulation layer)
    def "SimulationResults" (
        references = </World/FluidDomain>
    )
    {
    }

    # AI surrogate predictions (same CaeDataSet schema contract)
    def "SurrogatePrediction" (
        references = </Surrogate/PredictedFlow>
    )
    {
    }
}
